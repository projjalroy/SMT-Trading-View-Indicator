//@version=6
indicator("ICT SMT Divergence & CISD | Complete (Part 1+2+3+4)", shorttitle="ICT SMT CISD", overlay=true, max_lines_count=500, max_labels_count=500)

// =====================================================================================
//  PINE SCRIPT v6 CONVERSION of the v5 complete script (logic unchanged).
//  NEW: "Early SMT" mode (section 3b): on the mapped LTF chart the SMT is evaluated on the developing HTF candle and
//       confirmed by the LTF CISD instead of waiting for the HTF pivot. Toggle: Early SMT (CISD-confirmed) group.
//  v6 notes: and/or are lazy (f_chg() calls hoisted out of "or"), no int->bool coercion, no bool na.
//
//  FAST VERSION  (fixes runtime error RE10110 "script takes too long to execute")
//
//  TradingView limits every loop on every single bar to 0.5 s on the free plan, and an outer
//  loop counts everything running inside it. The old script ran huge hidden loops inside the
//  "for i = 0 to 5" filter loop on bars where several timeframes fired at once. Changes:
//    1. f_extT() scanned up to 4900 bars back with dynamic time[i]/low[i] lookups per event.
//       -> replaced by a tiny recorder of each HTF bar's high/low + time (Ext / f_extRec), O(10).
//    2. f_aligned() re-scanned 5 timeframes x 60 swings for EVERY level, on every query and on
//       every drawing refresh (60 x 300 compares).
//       -> alignment is now stored in each level (Liq.alIdx), updated only when a level is created
//          or a new HTF swing appears.
//    3. The "was this level swept" loop ran over the whole pool on every bar.
//       -> a min/max tracker (trk) means it only loops on bars that really sweep something.
//    4. 20+ New-York timezone conversions per bar -> 3 per bar (nyMin / nyDom computed once).
//    5. 24 new objects per bar (Swing / SMTResult) -> persistent objects updated in place.
//    6. max_bars_back=5000 removed (it made every series keep 5000 bars of history).
//    7. Level lines/labels are rebuilt once per new bar instead of on every realtime tick.
//    8. New optional input "Evaluate filters only on last N chart bars" (default 0 = all bars).
//  All features, inputs, alerts, tables and exported variable names are unchanged.
//
//  PART 4 (this file = Parts 1-4 assembled, see the PART 4 block near the end of the script):
//    - SMT trendlines between the two swing points that form each divergence, labelled Bullish / Bearish SMT
//    - green / red entry arrows on the exact candle where the LTF CISD confirms
//    - on-screen dashboard (6 timeframe pairs): SMT status | liquidity alignment | CISD status
//    - the 4 alert conditions (the old Part 2 / Part 3 alerts were folded into them)
//
//  NON-REPAINTING DESIGN (whole script):
//    * HTF swings come from request.security(..., lookahead_off) on the PREVIOUS closed HTF bar ([1]).
//    * The CISD is evaluated on CLOSED chart candles only (barstate.isconfirmed).
//    * PDH/PDL/PWH/PWL use the standard [1] + lookahead_on idiom (only ever shows the finished day / week).
//    * Drawings are created once, on the bar where the event is confirmed, and are never moved afterwards.
//    * Create alerts with "Once Per Bar Close".
// =====================================================================================

// =====================================================================================
//  PART 1 : INPUTS + MULTI-TIMEFRAME SWING ENGINE + RAW SMT DETECTION
//
//  Exports for Part 2 (all global, all non-repainting):
//    smtW / smtD / smtH4 / smtH1 / smtM30 / smtM15   -> SMTResult per timeframe
//    smtAll                                          -> array<SMTResult>, index 0..5 in the order above
//    chW..chM15, c1W..c1M15, c2W..c2M15              -> Swing objects (last 2 pivot highs/lows per symbol per TF)
//    bullAny / bearAny / bullRevAny / bearRevAny     -> any enabled TF currently diverging
//    bullCount / bearCount                           -> number of TFs currently diverging
//
//  SMTResult fields:
//    .bull .bear .bullRev .bearRev            = state: latest aligned swing pair currently diverges
//    .bullNew .bearNew .bullRevNew .bearRevNew = event: true only on the first chart bar the pair becomes valid
// =====================================================================================

// ============================== 1. INPUTS ============================================
GRP_SYM  = "Comparison Symbols"
GRP_MODE = "Divergence Logic"
GRP_PIV  = "Pivot / Tolerance"
GRP_TF   = "Timeframes"
GRP_DBG  = "Debug"

sym1    = input.symbol("CME_MINI:NQ1!", "Comparison Symbol 1", group=GRP_SYM)
inv1    = input.bool(false, "Symbol 1 inversely correlated", group=GRP_SYM, tooltip="Enable for DXY-type logic: chart HH is compared with the comparison symbol failing to make a LL (and vice versa).")
useSym2 = input.bool(false, "Enable Comparison Symbol 2", group=GRP_SYM)
sym2    = input.symbol("CME_MINI:YM1!", "Comparison Symbol 2", group=GRP_SYM)
inv2    = input.bool(false, "Symbol 2 inversely correlated", group=GRP_SYM)

cmpMode = input.string("ANY", "Comparison Mode", options=["ANY", "ALL"], group=GRP_MODE, tooltip="ANY: at least one enabled symbol diverges. ALL: every enabled symbol must diverge.")
useRev  = input.bool(false, "Detect Reverse SMT", group=GRP_MODE, tooltip="Reverse SMT: the chart symbol FAILS to make the new extreme while the comparison symbol makes it.\nBullish reverse = chart Higher Low + comp Lower Low.\nBearish reverse = chart Lower High + comp Higher High.")

pivL    = input.int(2, "Pivot Left Bars", minval=1, group=GRP_PIV)
pivR    = input.int(2, "Pivot Right Bars", minval=1, group=GRP_PIV)
tolBars = input.int(2, "Alignment Tolerance (+/- N bars)", minval=0, group=GRP_PIV, tooltip="Max distance, in bars of the swing's own timeframe, between the chart swing and the comparison swing.")
maxDist = input.int(30, "Max Bar Distance (M bars)", minval=1, group=GRP_PIV, tooltip="Max distance, in bars of the swing's own timeframe, between the current and the previous swing being compared (per symbol). Older swing pairs are ignored.")

enW   = input.bool(true, "", group=GRP_TF, inline="w")
tfW   = input.timeframe("W",   "Weekly", group=GRP_TF, inline="w")
enD   = input.bool(true, "", group=GRP_TF, inline="d")
tfD   = input.timeframe("D",   "Daily",  group=GRP_TF, inline="d")
enH4  = input.bool(true, "", group=GRP_TF, inline="h4")
tfH4  = input.timeframe("240", "H4",     group=GRP_TF, inline="h4")
enH1  = input.bool(true, "", group=GRP_TF, inline="h1")
tfH1  = input.timeframe("60",  "H1",     group=GRP_TF, inline="h1")
enM30 = input.bool(true, "", group=GRP_TF, inline="m30")
tfM30 = input.timeframe("30",  "M30",    group=GRP_TF, inline="m30")
enM15 = input.bool(true, "", group=GRP_TF, inline="m15")
tfM15 = input.timeframe("15",  "M15",    group=GRP_TF, inline="m15")

showDbg = input.bool(false, "Show Part 1 debug table (SMT raw states)", group=GRP_DBG)

// ============================== 2. TYPES =============================================
// Last two confirmed pivot highs / lows (price + HTF bar open time) for one symbol on one timeframe.
type Swing
    float hP     = na
    int   hT     = na
    float hPrev  = na
    int   hTPrev = na
    float lP     = na
    int   lT     = na
    float lPrev  = na
    int   lTPrev = na

type SMTResult
    string tf
    bool bull       = false
    bool bear       = false
    bool bullRev    = false
    bool bearRev    = false
    bool bullNew    = false
    bool bearNew    = false
    bool bullRevNew = false
    bool bearRevNew = false

// ============================== 3. SWING ENGINE ======================================
// Runs INSIDE request.security (on the requested symbol/timeframe).
// Keeps the last two pivots. Returns the state as of the PREVIOUS (closed) HTF bar via [1],
// so a pivot that is still being tentatively formed on the live HTF bar can never flicker or repaint.
f_swings(int L, int R) =>
    float ph = ta.pivothigh(high, L, R)
    float pl = ta.pivotlow(low, L, R)
    var float h0  = na
    var int   h0t = na
    var float h1  = na
    var int   h1t = na
    var float l0  = na
    var int   l0t = na
    var float l1  = na
    var int   l1t = na
    if not na(ph)
        h1  := h0
        h1t := h0t
        h0  := ph
        h0t := time[R]
    if not na(pl)
        l1  := l0
        l1t := l0t
        l0  := pl
        l0t := time[R]
    [h0[1], h0t[1], h1[1], h1t[1], l0[1], l0t[1], l1[1], l1t[1]]

// Loads the swings of one symbol / timeframe INTO an existing (persistent) Swing object.
// Updating in place avoids creating 18 new objects on every bar.
// Disabled timeframes request the chart's own symbol/timeframe instead (practically free) - their results are masked anyway.
f_loadInto(Swing s, string sym, string tf, bool on) =>
    [h0, h0t, h1, h1t, l0, l0t, l1, l1t] = request.security(on ? sym : syminfo.tickerid, on ? tf : timeframe.period, f_swings(pivL, pivR), lookahead=barmerge.lookahead_off)
    s.hP     := h0
    s.hT     := h0t
    s.hPrev  := h1
    s.hTPrev := h1t
    s.lP     := l0
    s.lT     := l0t
    s.lPrev  := l1
    s.lTPrev := l1t
    true

// Symbol 2 falls back to symbol 1 when disabled (keeps request arguments valid; results are masked later).
// Identical requests share their data, so this costs almost nothing.
sym2Eff = useSym2 ? sym2 : sym1

// Timeframe usable only if it is >= the chart timeframe.
f_tfOk(string tf) =>
    timeframe.in_seconds(tf) >= timeframe.in_seconds(timeframe.period)

onW   = enW   and f_tfOk(tfW)
onD   = enD   and f_tfOk(tfD)
onH4  = enH4  and f_tfOk(tfH4)
onH1  = enH1  and f_tfOk(tfH1)
onM30 = enM30 and f_tfOk(tfM30)
onM15 = enM15 and f_tfOk(tfM15)

// Persistent swing containers: 6 TFs x 3 symbols = 18 security requests (limit is 40)
var Swing chW   = Swing.new()
var Swing c1W   = Swing.new()
var Swing c2W   = Swing.new()
var Swing chD   = Swing.new()
var Swing c1D   = Swing.new()
var Swing c2D   = Swing.new()
var Swing chH4  = Swing.new()
var Swing c1H4  = Swing.new()
var Swing c2H4  = Swing.new()
var Swing chH1  = Swing.new()
var Swing c1H1  = Swing.new()
var Swing c2H1  = Swing.new()
var Swing chM30 = Swing.new()
var Swing c1M30 = Swing.new()
var Swing c2M30 = Swing.new()
var Swing chM15 = Swing.new()
var Swing c1M15 = Swing.new()
var Swing c2M15 = Swing.new()

f_loadInto(chW,   syminfo.tickerid, tfW, onW)
f_loadInto(c1W,   sym1,    tfW, onW)
f_loadInto(c2W,   sym2Eff, tfW, onW)

f_loadInto(chD,   syminfo.tickerid, tfD, onD)
f_loadInto(c1D,   sym1,    tfD, onD)
f_loadInto(c2D,   sym2Eff, tfD, onD)

f_loadInto(chH4,  syminfo.tickerid, tfH4, onH4)
f_loadInto(c1H4,  sym1,    tfH4, onH4)
f_loadInto(c2H4,  sym2Eff, tfH4, onH4)

f_loadInto(chH1,  syminfo.tickerid, tfH1, onH1)
f_loadInto(c1H1,  sym1,    tfH1, onH1)
f_loadInto(c2H1,  sym2Eff, tfH1, onH1)

f_loadInto(chM30, syminfo.tickerid, tfM30, onM30)
f_loadInto(c1M30, sym1,    tfM30, onM30)
f_loadInto(c2M30, sym2Eff, tfM30, onM30)

f_loadInto(chM15, syminfo.tickerid, tfM15, onM15)
f_loadInto(c1M15, sym1,    tfM15, onM15)
f_loadInto(c2M15, sym2Eff, tfM15, onM15)

GRP_PERF = "P2 | Performance"
histBars = input.int(3000, "Evaluate filters only on last N chart bars (0 = all)", minval=0, group=GRP_PERF, tooltip="Speed lever for the free plan. SMT events older than N chart bars are not filtered/labelled. Levels and swings are still tracked from the start of the chart. 0 = evaluate every bar. Default 3000 keeps the script inside the free-plan 20 s runtime limit.")
bool inScope = histBars <= 0 or bar_index >= last_bar_index - histBars   // heavy work (early SMT, CISD tracker, filters, drawings) only runs on the last N bars

GRP_P3 = "P3 | CISD Confirmation (HTF SMT -> LTF CISD)"
ltfW    = input.timeframe("240", "Weekly SMT -> CISD on", group=GRP_P3)
ltfD    = input.timeframe("60",  "Daily SMT -> CISD on",  group=GRP_P3)
ltfH4   = input.timeframe("15",  "H4 SMT -> CISD on",     group=GRP_P3)
ltfH1   = input.timeframe("5",   "H1 SMT -> CISD on",     group=GRP_P3)
ltfM30  = input.timeframe("3",   "M30 SMT -> CISD on",    group=GRP_P3)
ltfM15  = input.timeframe("1",   "M15 SMT -> CISD on",    group=GRP_P3)

// ============================== 3b. EARLY SMT MODE (CISD-confirmed) ==================
// Normal mode waits for a CONFIRMED HTF pivot (pivR HTF candles after the swing). Early mode does not wait:
//   * on the LTF chart that is mapped to an SMT timeframe (e.g. M5 chart -> H1 SMT) the DEVELOPING HTF candle is
//     tracked from the chart's own bars (comparison symbols come from a same-timeframe request);
//   * if the chart symbol's developing HTF candle sweeps its latest confirmed swing high/low while the comparison
//     symbol's developing candle does NOT sweep ITS latest swing -> a PROVISIONAL swing replaces the confirmed one
//     and the normal pipeline (SMT -> filters -> pending) runs on it, on closed LTF bars only;
//   * the LTF CISD (Part 3) is the confirmation. The setup is cancelled if the divergence disappears
//     (comparison symbol sweeps too) or the swing extreme is broken after the HTF candle closed.
// Only the SMT timeframe mapped to the current chart timeframe uses early mode; the others stay pivot-confirmed.
GRP_EARLY = "Early SMT (CISD-confirmed)"
earlyMode = input.bool(true, "Early SMT mode (do not wait for the HTF pivot)", group=GRP_EARLY, tooltip="ON: on the mapped LTF chart (e.g. M5 for H1 SMT) the SMT is evaluated on the developing HTF candle and confirmed by the LTF CISD (about 15 min instead of waiting 2 HTF candles).\nOFF: classic pivot-confirmed SMT only.\nThe setup repaints until the CISD prints; the CISD signal itself is only given on closed LTF bars.")

int chartSec0 = timeframe.in_seconds(timeframe.period)
// index of the SMT timeframe mapped to the current chart timeframe (-1 = chart is not a mapped LTF)
int eTi = onW and timeframe.in_seconds(ltfW) == chartSec0 ? 0 : onD and timeframe.in_seconds(ltfD) == chartSec0 ? 1 : onH4 and timeframe.in_seconds(ltfH4) == chartSec0 ? 2 : onH1 and timeframe.in_seconds(ltfH1) == chartSec0 ? 3 : onM30 and timeframe.in_seconds(ltfM30) == chartSec0 ? 4 : onM15 and timeframe.in_seconds(ltfM15) == chartSec0 ? 5 : -1
bool eAct = earlyMode and eTi >= 0
bool eRun = eAct and inScope   // tracking / override only inside the evaluated window
string eTf = eTi == 0 ? tfW : eTi == 1 ? tfD : eTi == 2 ? tfH4 : eTi == 3 ? tfH1 : eTi == 4 ? tfM30 : tfM15

// comparison symbols on the CHART timeframe (2 extra requests; sym2 falls back to sym1 when disabled -> shared data)
[c1hi, c1lo] = request.security(eAct ? sym1 : syminfo.tickerid,    timeframe.period, [high, low], lookahead=barmerge.lookahead_off)
[c2hi, c2lo] = request.security(eAct ? sym2Eff : syminfo.tickerid, timeframe.period, [high, low], lookahead=barmerge.lookahead_off)

int eBt = eRun ? time(eTf) : na   // open time of the developing HTF candle

var int   pBt  = na
var float eChH = na
var float eChL = na
var float eC1H = na
var float eC1L = na
var float eC2H = na
var float eC2L = na
// last closed HTF candles (time, high, low): used to ignore a candidate when a recent closed candle already went higher / lower
var array<int>   eHT = array.new<int>()
var array<float> eHH = array.new<float>()
var array<float> eHL = array.new<float>()

if eRun and not na(eBt)
    if na(pBt) or eBt != pBt
        if not na(pBt)
            bool seen = eHT.size() > 0
            if seen
                seen := eHT.last() == pBt
            if not seen
                eHT.push(pBt)
                eHH.push(eChH)
                eHL.push(eChL)
                if eHT.size() > 6
                    eHT.shift()
                    eHH.shift()
                    eHL.shift()
        eChH := high
        eChL := low
        eC1H := c1hi
        eC1L := c1lo
        eC2H := c2hi
        eC2L := c2lo
    else
        eChH := math.max(eChH, high)
        eChL := math.min(eChL, low)
        eC1H := math.max(eC1H, c1hi)
        eC1L := math.min(eC1L, c1lo)
        eC2H := math.max(eC2H, c2hi)
        eC2L := math.min(eC2L, c2lo)
    pBt := eBt

// highest high / lowest low of the CLOSED HTF candles newer than afterT
f_closedExt(int afterT, bool wantHigh) =>
    float r = na
    int n = eHT.size()
    if n > 0
        for k = 0 to n - 1
            if eHT.get(k) > afterT
                float v = wantHigh ? eHH.get(k) : eHL.get(k)
                r := na(r) ? v : (wantHigh ? math.max(r, v) : math.min(r, v))
    r

// Pushes the developing candle of a comparison symbol in as that symbol's newest (provisional) swing.
// Bearish side (hiSide) uses the symbol's highs, or its lows when inversely correlated; bullish side the opposite.
f_shiftCp(Swing cp, bool inv, bool hiSide, int bt, float cH, float cL) =>
    bool useHigh = hiSide != inv
    if useHigh
        cp.hTPrev := cp.hT
        cp.hPrev  := cp.hP
        cp.hP     := cH
        cp.hT     := bt
    else
        cp.lTPrev := cp.lT
        cp.lPrev  := cp.lP
        cp.lP     := cL
        cp.lT     := bt
    true

var array<Swing> eCh = array.new<Swing>(6)
var array<Swing> eC1 = array.new<Swing>(6)
var array<Swing> eC2 = array.new<Swing>(6)
if barstate.isfirst
    eCh.set(0, chW)
    eCh.set(1, chD)
    eCh.set(2, chH4)
    eCh.set(3, chH1)
    eCh.set(4, chM30)
    eCh.set(5, chM15)
    eC1.set(0, c1W)
    eC1.set(1, c1D)
    eC1.set(2, c1H4)
    eC1.set(3, c1H1)
    eC1.set(4, c1M30)
    eC1.set(5, c1M15)
    eC2.set(0, c2W)
    eC2.set(1, c2D)
    eC2.set(2, c2H4)
    eC2.set(3, c2H1)
    eC2.set(4, c2M30)
    eC2.set(5, c2M15)

bool eHiOn = false   // provisional swing HIGH active this bar (bearish early SMT candidate)
bool eLoOn = false   // provisional swing LOW  active this bar (bullish early SMT candidate)
if eRun and not na(eBt) and not na(eChH)
    Swing ea  = eCh.get(eTi)
    Swing eb1 = eC1.get(eTi)
    Swing eb2 = eC2.get(eTi)
    if not na(ea.hT) and eBt > ea.hT and eChH > ea.hP
        float cm = f_closedExt(ea.hT, true)
        if na(cm) or eChH > cm
            eHiOn := true
            ea.hTPrev := ea.hT
            ea.hPrev  := ea.hP
            ea.hP     := eChH
            ea.hT     := eBt
            f_shiftCp(eb1, inv1, true, eBt, eC1H, eC1L)
            f_shiftCp(eb2, inv2, true, eBt, eC2H, eC2L)
    if not na(ea.lT) and eBt > ea.lT and eChL < ea.lP
        float cn = f_closedExt(ea.lT, false)
        if na(cn) or eChL < cn
            eLoOn := true
            ea.lTPrev := ea.lT
            ea.lPrev  := ea.lP
            ea.lP     := eChL
            ea.lT     := eBt
            f_shiftCp(eb1, inv1, false, eBt, eC1H, eC1L)
            f_shiftCp(eb2, inv2, false, eBt, eC2H, eC2L)

// ============================== 4. SMT LOGIC =========================================
// True on the bar a value changes (or first appears).
f_chg(int x) =>
    x != x[1] or (na(x[1]) and not na(x))

// Compares the chart's latest two swings against ONE comparison symbol on ONE timeframe.
// Non-inverse comp : chart lows vs comp lows, chart highs vs comp highs.
// Inverse comp     : chart lows vs comp HIGHS, chart highs vs comp LOWS (a chart LL is "confirmed" by a comp HH).
//
// "Comp made equivalent of lower"  = non-inverse: x0 < x1 | inverse: x0 > x1
// "Comp made equivalent of higher" = non-inverse: x0 > x1 | inverse: x0 < x1
//
// Bullish SMT      : chart Lower Low   + comp equivalent-of-higher (comp refuses to confirm the new low)
// Bearish SMT      : chart Higher High + comp equivalent-of-lower
// Bullish Rev SMT  : chart Higher Low  + comp equivalent-of-lower
// Bearish Rev SMT  : chart Lower High  + comp equivalent-of-higher
//
// Returns [bull, bear, bullRev, bearRev, bullNew, bearNew, bullRevNew, bearRevNew]
f_pair(Swing ch, Swing cp, bool inv, bool revOn, int tfMs, int tol, int maxD, bool early, bool eHi, bool eLo) =>
    // comp pivots paired with chart LOW swings
    float lx0 = inv ? cp.hP     : cp.lP
    float lx1 = inv ? cp.hPrev  : cp.lPrev
    int   lt0 = inv ? cp.hT     : cp.lT
    int   lt1 = inv ? cp.hTPrev : cp.lTPrev
    // comp pivots paired with chart HIGH swings
    float hx0 = inv ? cp.lP     : cp.hP
    float hx1 = inv ? cp.lPrev  : cp.hPrev
    int   ht0 = inv ? cp.lT     : cp.hT
    int   ht1 = inv ? cp.lTPrev : cp.hTPrev

    // alignment (+/- N bars between chart swing and comp swing) and max distance (M bars between prev and current swing)
    bool lowOk = math.abs(ch.lT - lt0) / tfMs <= tol and (ch.lT - ch.lTPrev) / tfMs <= maxD and (lt0 - lt1) / tfMs <= maxD
    bool hiOk  = math.abs(ch.hT - ht0) / tfMs <= tol and (ch.hT - ch.hTPrev) / tfMs <= maxD and (ht0 - ht1) / tfMs <= maxD

    // chart structure
    bool chLL = ch.lP < ch.lPrev
    bool chHL = ch.lP > ch.lPrev
    bool chHH = ch.hP > ch.hPrev
    bool chLH = ch.hP < ch.hPrev

    // comp structure (inverse-aware)
    bool lLower  = inv ? lx0 > lx1 : lx0 < lx1
    bool lHigher = inv ? lx0 < lx1 : lx0 > lx1
    bool hLower  = inv ? hx0 > hx1 : hx0 < hx1
    bool hHigher = inv ? hx0 < hx1 : hx0 > hx1

    bool bull    = lowOk and chLL and lHigher
    bool bear    = hiOk  and chHH and hLower
    bool bullRev = revOn and lowOk and chHL and lLower
    bool bearRev = revOn and hiOk  and chLH and hHigher

    // event flags: pair is valid AND either swing of the pair changed on this bar
    // v6: 'or' is lazy -> evaluate every f_chg() call on every bar first so its history buffer stays consistent
    bool chLowChg = f_chg(ch.lT)
    bool cpLowChg = f_chg(lt0)
    bool chHiChg  = f_chg(ch.hT)
    bool cpHiChg  = f_chg(ht0)
    bool lowChg = chLowChg or cpLowChg
    bool hiChg  = chHiChg or cpHiChg

    // EARLY mode (mapped LTF chart): an event is the first CLOSED chart bar on which the provisional-swing divergence is true.
    // Hoisted so the history buffers are fed on every bar (v6 lazy and/or).
    bool bullE  = eLo and bull
    bool bearE  = eHi and bear
    bool bullEP = bullE[1]
    bool bearEP = bearE[1]
    bool cfm    = barstate.isconfirmed
    bool bullEv = early ? (cfm and bullE and not bullEP) : (bull and lowChg)
    bool bearEv = early ? (cfm and bearE and not bearEP) : (bear and hiChg)
    bool bullRevEv = early ? false : (bullRev and lowChg)
    bool bearRevEv = early ? false : (bearRev and hiChg)

    [bull, bear, bullRev, bearRev, bullEv, bearEv, bullRevEv, bearRevEv]

// Combine comp 1 / comp 2 according to ANY / ALL.
f_comb(bool a, bool b) =>
    useSym2 ? (cmpMode == "ALL" ? (a and b) : (a or b)) : a

f_combNew(bool act, bool n1, bool n2) =>
    act and (n1 or (useSym2 and n2))

// Evaluates one timeframe and writes the result INTO the persistent SMTResult object r.
f_tf_eval(SMTResult r, string tf, bool on, Swing ch, Swing c1, Swing c2, bool early) =>
    int tfMs = timeframe.in_seconds(tf) * 1000
    [b1, s1, br1, sr1, bn1, sn1, brn1, srn1] = f_pair(ch, c1, inv1, useRev, tfMs, tolBars, maxDist, early, eHiOn, eLoOn)
    [b2, s2, br2, sr2, bn2, sn2, brn2, srn2] = f_pair(ch, c2, inv2, useRev, tfMs, tolBars, maxDist, early, eHiOn, eLoOn)

    bool bull    = on and f_comb(b1, b2)
    bool bear    = on and f_comb(s1, s2)
    bool bullRev = on and f_comb(br1, br2)
    bool bearRev = on and f_comb(sr1, sr2)

    r.bull       := bull
    r.bear       := bear
    r.bullRev    := bullRev
    r.bearRev    := bearRev
    r.bullNew    := f_combNew(bull, bn1, bn2)
    r.bearNew    := f_combNew(bear, sn1, sn2)
    r.bullRevNew := f_combNew(bullRev, brn1, brn2)
    r.bearRevNew := f_combNew(bearRev, srn1, srn2)
    true

var SMTResult smtW   = SMTResult.new("W")
var SMTResult smtD   = SMTResult.new("D")
var SMTResult smtH4  = SMTResult.new("H4")
var SMTResult smtH1  = SMTResult.new("H1")
var SMTResult smtM30 = SMTResult.new("M30")
var SMTResult smtM15 = SMTResult.new("M15")

f_tf_eval(smtW,   tfW,   onW,   chW,   c1W,   c2W, earlyMode and eTi == 0)
f_tf_eval(smtD,   tfD,   onD,   chD,   c1D,   c2D, earlyMode and eTi == 1)
f_tf_eval(smtH4,  tfH4,  onH4,  chH4,  c1H4,  c2H4, earlyMode and eTi == 2)
f_tf_eval(smtH1,  tfH1,  onH1,  chH1,  c1H1,  c2H1, earlyMode and eTi == 3)
f_tf_eval(smtM30, tfM30, onM30, chM30, c1M30, c2M30, earlyMode and eTi == 4)
f_tf_eval(smtM15, tfM15, onM15, chM15, c1M15, c2M15, earlyMode and eTi == 5)

var array<SMTResult> smtAll = array.new<SMTResult>(6)
smtAll.set(0, smtW)
smtAll.set(1, smtD)
smtAll.set(2, smtH4)
smtAll.set(3, smtH1)
smtAll.set(4, smtM30)
smtAll.set(5, smtM15)

// ============================== 5. AGGREGATE EXPORTS =================================
int bullCount = 0
int bearCount = 0
int bullRevCount = 0
int bearRevCount = 0
for i = 0 to 5
    SMTResult r = smtAll.get(i)
    bullCount    += r.bull    ? 1 : 0
    bearCount    += r.bear    ? 1 : 0
    bullRevCount += r.bullRev ? 1 : 0
    bearRevCount += r.bearRev ? 1 : 0

bool bullAny    = bullCount > 0
bool bearAny    = bearCount > 0
bool bullRevAny = bullRevCount > 0
bool bearRevAny = bearRevCount > 0

// ============================== 6. DEBUG TABLE =======================================
f_txt(bool act, bool nw) =>
    nw ? "NEW" : act ? "●" : "·"

f_bg(bool act, bool nw, color c) =>
    nw ? color.new(c, 10) : act ? color.new(c, 55) : color.new(color.gray, 90)

var table dbg = table.new(position.top_right, 5, 7, border_width=1)
if showDbg and barstate.islast
    hdr = array.from("TF", "Bull", "Bear", "R-Bull", "R-Bear")
    for c = 0 to 4
        table.cell(dbg, c, 0, hdr.get(c), text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    for i = 0 to 5
        SMTResult r = smtAll.get(i)
        table.cell(dbg, 0, i + 1, r.tf, text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
        table.cell(dbg, 1, i + 1, f_txt(r.bull,    r.bullNew),    text_color=color.white, bgcolor=f_bg(r.bull,    r.bullNew,    color.green), text_size=size.small)
        table.cell(dbg, 2, i + 1, f_txt(r.bear,    r.bearNew),    text_color=color.white, bgcolor=f_bg(r.bear,    r.bearNew,    color.red),   text_size=size.small)
        table.cell(dbg, 3, i + 1, f_txt(r.bullRev, r.bullRevNew), text_color=color.white, bgcolor=f_bg(r.bullRev, r.bullRevNew, color.teal),  text_size=size.small)
        table.cell(dbg, 4, i + 1, f_txt(r.bearRev, r.bearRevNew), text_color=color.white, bgcolor=f_bg(r.bearRev, r.bearRevNew, color.orange), text_size=size.small)


// =====================================================================================
//  PART 2 : NY MIDNIGHT OPEN FILTER + KILLZONE FILTER + LIQUIDITY SWEEP / MTF ALIGNMENT
//
//  Takes every Part 1 "New" SMT event (bullNew / bearNew, regular SMT) and validates it:
//    1. Midnight Open : bull swing low  < NY 00:00 open | bear swing high > NY 00:00 open
//    2. Killzone      : the swing's extreme formed inside Asia / London / NY AM / NY PM (NY time)
//    3. Liquidity     : the swing swept a FRESH level (PDH/PDL/PWH/PWL/session H/L) that is aligned
//                       with an established swing high/low on W / D / H4 / H1 / M30
//
//  Exports for Part 3 (CISD):
//    okBull[i] / okBear[i]       -> filtered SMT event on TF index i (0=W,1=D,2=H4,3=H1,4=M30,5=M15)
//    bullSig / bearSig           -> any TF produced a fully filtered SMT event on this bar
//    bullSigCount / bearSigCount -> number of TFs
//    lastBullSigPrice / lastBullSigBar (and Bear) -> most recent filtered swing price / bar_index
//    nyOpen                      -> current NY 00:00 open
//    pool                        -> array<Liq> of all tracked liquidity levels (f_aligned(L) != "" means valid)
// =====================================================================================

// ============================== 7. PART 2 INPUTS =====================================
GRP_MID  = "P2 | NY Midnight Open"
GRP_KZ   = "P2 | Killzones (New York time)"
GRP_LIQ  = "P2 | Liquidity Sweep & MTF Alignment"
GRP_VIS  = "P2 | Visuals"

string TZ = "America/New_York"

useMid  = input.bool(true, "Enable Midnight Open filter", group=GRP_MID)
midRef  = input.string("Day of swing", "Reference open", options=["Day of swing", "Current day"], group=GRP_MID, tooltip="Day of swing: compare with the NY 00:00 open of the day the swing formed.\nCurrent day: compare with today's NY 00:00 open.")

useKZ   = input.bool(true, "Enable Killzone filter", group=GRP_KZ)
kzAsia  = input.bool(true, "Asia 20:00-00:00",   group=GRP_KZ)
kzLon   = input.bool(true, "London 02:00-05:00", group=GRP_KZ)
kzAM    = input.bool(true, "NY AM 07:00-11:00",  group=GRP_KZ)
kzPM    = input.bool(true, "NY PM 13:00-16:00",  group=GRP_KZ)

useSweep = input.bool(true, "Enable Liquidity Sweep filter", group=GRP_LIQ)
usePD    = input.bool(true, "Use PDH / PDL", group=GRP_LIQ)
usePW    = input.bool(true, "Use PWH / PWL", group=GRP_LIQ)
useSess  = input.bool(true, "Use Session Highs / Lows (Asia, London, NY AM, NY PM)", group=GRP_LIQ)
alW      = input.bool(true, "Align with Weekly swing", group=GRP_LIQ, inline="al1")
alD      = input.bool(true, "Daily",  group=GRP_LIQ, inline="al1")
alH4     = input.bool(true, "H4",     group=GRP_LIQ, inline="al2")
alH1     = input.bool(true, "H1",     group=GRP_LIQ, inline="al2")
alM30    = input.bool(true, "M30",    group=GRP_LIQ, inline="al2")
alTol    = input.float(2.0, "Alignment tolerance (ticks)", minval=0, step=0.5, group=GRP_LIQ, tooltip="Max price distance between a liquidity level and the swing high/low it must align with.")
maxPool  = input.int(60, "Max tracked levels", minval=10, maxval=200, group=GRP_LIQ)

showMid  = input.bool(true, "Plot NY 00:00 Open", group=GRP_VIS)
showKZbg = input.bool(true, "Shade killzones", group=GRP_VIS)
showLvl  = input.bool(true, "Draw liquidity levels", group=GRP_VIS)
showInv  = input.bool(false, "Also draw non-aligned (invalid) levels", group=GRP_VIS)
showSwpt = input.bool(false, "Also draw swept levels", group=GRP_VIS)
showSig  = input.bool(true, "Label filtered SMT signals", group=GRP_VIS)
showDbg2 = input.bool(false, "Show Part 2 debug table", group=GRP_VIS)


// ============================== 8. TYPES =============================================
// One tracked liquidity level. t = time of the extreme, endT = when the level became "finished" liquidity.
// alIdx = first alignment timeframe (0=W 1=D 2=H4 3=H1 4=M30) whose swing high/low matches the level, 99 = not aligned.
type Liq
    string name
    bool   isHigh
    float  price
    int    t
    int    endT
    int    sweptT = na   // first chart bar that traded through it after endT
    int    alIdx  = 99

// History of confirmed pivot prices (chart symbol) for one alignment timeframe.
type SwingBook
    array<float> highs
    array<float> lows
    int lastHT = na
    int lastLT = na

// Recorder of the most recent HTF bars as seen on the chart: HTF bar open time + its high/low and the
// chart-bar time at which they printed. Lets us find "when did the swing extreme form" in O(10)
// instead of scanning thousands of chart bars.
type Ext
    array<int>   t0s
    array<float> his
    array<int>   hiTs
    array<float> los
    array<int>   loTs

// ============================== 9. TIME HELPERS ======================================
f_mod(int t) =>
    hour(t, TZ) * 60 + minute(t, TZ)

// minute-of-day window test, supports windows that wrap past midnight
f_inWin(int m, int s, int e) =>
    s < e ? (m >= s and m < e) : (m >= s or m < e)

// Killzone name for a minute-of-day value ("" = outside / disabled)
f_kzM(int m) =>
    string r = ""
    if kzAsia and f_inWin(m, 1200, 0)
        r := "Asia"
    else if kzLon and f_inWin(m, 120, 300)
        r := "London"
    else if kzAM and f_inWin(m, 420, 660)
        r := "NY AM"
    else if kzPM and f_inWin(m, 780, 960)
        r := "NY PM"
    r

// Killzone name for a timestamp
f_kzName(int t) =>
    f_kzM(f_mod(t))

// Fallback when the exact extreme bar cannot be found: does the HTF bar [t0, t0+span) touch a killzone?
f_kzSpan(int t0, int span) =>
    string r = ""
    if span >= 86400000
        r := "HTF"
    else
        int n = math.min(int(span / 900000), 96)
        for k = 0 to n
            string z = f_kzName(t0 + k * 900000)
            if z != ""
                r := z
                break
    r

// ============================== 10. NY MIDNIGHT OPEN =================================
// New York minute-of-day and day-of-month are computed ONCE per bar (timezone conversions are slow).
int nyMin = hour(time, TZ) * 60 + minute(time, TZ)
int nyDom = dayofmonth(time, TZ)
var int prevDom = na
bool newNYDay = not na(prevDom) and nyDom != prevDom
prevDom := nyDom

var float nyOpen = na
var array<int>   dayOpT = array.new<int>()
var array<float> dayOpP = array.new<float>()
if newNYDay
    nyOpen := open
    dayOpT.push(time)
    dayOpP.push(open)
    if dayOpT.size() > 250
        dayOpT.shift()
        dayOpP.shift()

// NY 00:00 open that applies to timestamp t (per input)
f_openFor(int t) =>
    float r = nyOpen
    if midRef == "Day of swing"
        r := na
        if dayOpT.size() > 0
            for j = dayOpT.size() - 1 to 0
                if dayOpT.get(j) <= t
                    r := dayOpP.get(j)
                    break
    r

plot(showMid ? (newNYDay ? na : nyOpen) : na, "NY 00:00 Open", color=color.orange, linewidth=2, style=plot.style_linebr)

// ============================== 11. CONTAINERS =======================================
var array<Liq>       pool    = array.new<Liq>()
var array<float>     trk     = array.new_float(2, na)   // [0] lowest unswept HIGH level price, [1] highest unswept LOW level price
var array<Ext>       exts    = array.new<Ext>()         // one recorder per SMT timeframe (0=W 1=D 2=H4 3=H1 4=M30 5=M15)
var array<SwingBook> books   = array.new<SwingBook>()    // one swing history per ALIGNMENT timeframe (0=W 1=D 2=H4 3=H1 4=M30)
var array<string>    tfNames = array.from("W", "D", "H4", "H1", "M30")

// Alignment TFs: W, D, H4, H1, M30 (M15 is not an alignment timeframe)
var array<bool> alEn = array.from(onW and alW, onD and alD, onH4 and alH4, onH1 and alH1, onM30 and alM30)

if barstate.isfirst
    for i = 0 to 4
        books.push(SwingBook.new(array.new<float>(), array.new<float>()))
    for i = 0 to 5
        exts.push(Ext.new(array.new<int>(), array.new<float>(), array.new<int>(), array.new<float>(), array.new<int>()))

// Chart-symbol swing objects from Part 1, same index order as smtAll (0=W 1=D 2=H4 3=H1 4=M30 5=M15)
var array<Swing> chAll = array.new<Swing>(6)
chAll.set(0, chW)
chAll.set(1, chD)
chAll.set(2, chH4)
chAll.set(3, chH1)
chAll.set(4, chM30)
chAll.set(5, chM15)

var array<int> tfMsAll = array.from(timeframe.in_seconds(tfW) * 1000, timeframe.in_seconds(tfD) * 1000, timeframe.in_seconds(tfH4) * 1000, timeframe.in_seconds(tfH1) * 1000, timeframe.in_seconds(tfM30) * 1000, timeframe.in_seconds(tfM15) * 1000)

// ============================== 12. HTF EXTREME RECORDER =============================
// Called once per chart bar per timeframe. Keeps only the last few HTF bars.
f_extUpd(int ti, int bt, bool en) =>
    if en and not na(bt)
        Ext e = exts.get(ti)
        int n = e.t0s.size()
        // (v6: and/or are lazy, v5 was not - keep the explicit size check anyway)
        bool isNewBar = n == 0
        if not isNewBar
            isNewBar := e.t0s.get(n - 1) != bt
        if isNewBar
            e.t0s.push(bt)
            e.his.push(high)
            e.hiTs.push(time)
            e.los.push(low)
            e.loTs.push(time)
            if n + 1 > pivR + tolBars + 10
                e.t0s.shift()
                e.his.shift()
                e.hiTs.shift()
                e.los.shift()
                e.loTs.shift()
        else
            int k = n - 1
            if high >= e.his.get(k)
                e.his.set(k, high)
                e.hiTs.set(k, time)
            if low <= e.los.get(k)
                e.los.set(k, low)
                e.loTs.set(k, time)
    true

// Chart-bar time at which the extreme of the HTF bar containing bt printed (na if that HTF bar is not recorded).
f_extRec(int ti, bool isLow, int bt, int span) =>
    int res = na
    Ext e = exts.get(ti)
    int n = e.t0s.size()
    if n > 0
        for k = n - 1 to 0
            int s0 = e.t0s.get(k)
            if s0 <= bt
                if bt < s0 + span
                    res := isLow ? e.loTs.get(k) : e.hiTs.get(k)
                break
    res

int xbW   = onW   ? time(tfW)   : na
int xbD   = onD   ? time(tfD)   : na
int xbH4  = onH4  ? time(tfH4)  : na
int xbH1  = onH1  ? time(tfH1)  : na
int xbM30 = onM30 ? time(tfM30) : na
int xbM15 = onM15 ? time(tfM15) : na

f_extUpd(0, xbW,   onW)
f_extUpd(1, xbD,   onD)
f_extUpd(2, xbH4,  onH4)
f_extUpd(3, xbH1,  onH1)
f_extUpd(4, xbM30, onM30)
f_extUpd(5, xbM15, onM15)

// ============================== 13. MTF SWING ALIGNMENT ==============================
// First alignment timeframe whose stored swing high/low matches the level (99 = none). Scans the books ONCE,
// only when a level is created.
f_alignIdx(Liq L) =>
    int r = 99
    float tol = alTol * syminfo.mintick
    for b = 0 to 4
        if r == 99 and alEn.get(b)
            SwingBook bk = books.get(b)
            array<float> arr = L.isHigh ? bk.highs : bk.lows
            if arr.size() > 0
                for j = 0 to arr.size() - 1
                    if math.abs(arr.get(j) - L.price) <= tol
                        r := b
                        break
    r

// "" = level NOT aligned (skipped), otherwise the name of the aligning timeframe. O(1).
f_aligned(Liq L) =>
    string r = ""
    if L.alIdx < 99
        r := tfNames.get(L.alIdx)
    r

// A new swing appeared on alignment timeframe bi: update every level it aligns with (loops the pool once).
f_alignNew(int bi, bool isHigh, float p) =>
    float tol = alTol * syminfo.mintick
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Liq lv = pool.get(i)
            if lv.isHigh == isHigh and bi < lv.alIdx and math.abs(lv.price - p) <= tol
                lv.alIdx := bi
    true

f_bookUpd(int bi, Swing ch, bool en) =>
    if en
        SwingBook b = books.get(bi)
        if not na(ch.hT) and not na(ch.hP) and ch.hT != nz(b.lastHT)
            b.highs.push(ch.hP)
            b.lastHT := ch.hT
            if b.highs.size() > 60
                b.highs.shift()
            f_alignNew(bi, true, ch.hP)
        if not na(ch.lT) and not na(ch.lP) and ch.lT != nz(b.lastLT)
            b.lows.push(ch.lP)
            b.lastLT := ch.lT
            if b.lows.size() > 60
                b.lows.shift()
            f_alignNew(bi, false, ch.lP)
    true

for i = 0 to 4
    f_bookUpd(i, chAll.get(i), alEn.get(i))

// ============================== 14. LIQUIDITY POOL ===================================
// Recomputes the sweep tracker: lowest price among unswept HIGH levels, highest among unswept LOW levels.
// The per-bar sweep check below only loops the pool on bars where price actually reaches one of them.
f_trkRecalc() =>
    float mh = na
    float ml = na
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Liq lv = pool.get(i)
            if na(lv.sweptT)
                if lv.isHigh
                    mh := na(mh) ? lv.price : math.min(mh, lv.price)
                else
                    ml := na(ml) ? lv.price : math.max(ml, lv.price)
    trk.set(0, mh)
    trk.set(1, ml)
    true

f_addLevel(string name, bool isHigh, float price, int t, int endT) =>
    bool isPD = name == "PDH" or name == "PDL"
    bool isPW = name == "PWH" or name == "PWL"
    bool allowed = isPD ? usePD : isPW ? usePW : useSess
    if allowed and not na(price)
        if isPD or isPW
            if pool.size() > 0
                for i = pool.size() - 1 to 0
                    if pool.get(i).name == name
                        pool.remove(i)
        Liq nl = Liq.new(name, isHigh, price, t, endT)
        nl.alIdx := f_alignIdx(nl)
        pool.push(nl)
        if pool.size() > maxPool
            pool.shift()
        f_trkRecalc()
    true

// Session tracker (one call per session, state is kept per call). Finalises H/L when the session ends.
f_sess(string nm, int s, int e) =>
    var float hi  = na
    var float lo  = na
    var int   hiT = na
    var int   loT = na
    var bool  wasIn = false
    bool inS = f_inWin(nyMin, s, e)
    if inS and not wasIn
        hi := high
        lo := low
        hiT := time
        loT := time
    else if inS
        if high > hi
            hi := high
            hiT := time
        if low < lo
            lo := low
            loT := time
    if not inS and wasIn and not na(hi)
        f_addLevel(nm + " H", true, hi, hiT, time)
        f_addLevel(nm + " L", false, lo, loT, time)
        hi := na
        lo := na
    wasIn := inS
    true

bool sessA = f_sess("Asia",   1200, 0)
bool sessL = f_sess("London", 120,  300)
bool sessN = f_sess("NY AM",  420,  660)
bool sessP = f_sess("NY PM",  780,  960)

// PDH/PDL and PWH/PWL from the chart symbol's own D / W bars (same bars the Daily/Weekly swings are built from)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead=barmerge.lookahead_on)
[pwH, pwL, pwT] = request.security(syminfo.tickerid, "W", [high[1], low[1], time[1]], lookahead=barmerge.lookahead_on)

if f_chg(pdT)
    f_addLevel("PDH", true,  pdH, pdT, time)
    f_addLevel("PDL", false, pdL, pdT, time)
if f_chg(pwT)
    f_addLevel("PWH", true,  pwH, pwT, time)
    f_addLevel("PWL", false, pwL, pwT, time)

// Mark levels as swept the first time price trades through them after they finished.
// Loops the pool ONLY on bars where price reaches the nearest unswept high / low.
float trkH = trk.get(0)
float trkL = trk.get(1)
if (not na(trkH) and high > trkH) or (not na(trkL) and low < trkL)
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Liq lv = pool.get(i)
            if na(lv.sweptT) and time >= lv.endT
                if (lv.isHigh ? high > lv.price : low < lv.price)
                    lv.sweptT := time
    f_trkRecalc()

// Did a swing (price swP, HTF bar open swBarT, extreme time swT) sweep a fresh, aligned level?
// wantHigh = true -> looks for highs (bearish SMT) ; false -> looks for lows (bullish SMT)
// Returns [validLevel, skippedLevel]:
//   validLevel   = "NAME (alignTF)" of the first swept level aligned with a W/D/H4/H1/M30 swing, "" if none
//   skippedLevel = name of a swept level that was NOT aligned (skipped), "" if none   (used by the Part 4 dashboard)
f_sweep(bool wantHigh, float swP, int swBarT, int swT) =>
    string r  = ""
    string sk = ""
    if pool.size() > 0
        for i = pool.size() - 1 to 0
            Liq L = pool.get(i)
            bool beyond = wantHigh ? swP > L.price : swP < L.price
            if L.isHigh == wantHigh and L.endT <= swT and beyond and not na(L.sweptT) and L.sweptT >= swBarT
                string a = f_aligned(L)
                if a != ""
                    r := L.name + " (" + a + ")"
                    break
                else if sk == ""
                    sk := L.name
    [r, sk]

// ============================== P3-A. PART 3 INPUTS / STATE ==========================
// SMT timeframe (index 0=W 1=D 2=H4 3=H1 4=M30 5=M15)  ->  mapped LTF used for the CISD confirmation.
// (GRP_P3 and the six "SMT -> CISD on" timeframe inputs now live in section 3b, above the SMT logic)
maxConf = input.int(30, "Max Confirmation Bars (mapped LTF bars)", minval=1, group=GRP_P3, tooltip="A CISD only counts if it happens no later than this many bars of the mapped LTF after the SMT was confirmed. A CISD that already happened between the SMT extreme and the confirmation is accepted (looked up retroactively).")
showCisd = input.bool(true, "Show CISD line / label", group=GRP_P3)
showTbl3 = input.bool(false, "Show Part 3 status table", group=GRP_P3)

// ============================== P4-A. PART 4 INPUTS / HELPERS ========================
GRP_P4V = "P4 | SMT Overlay & Entry Markers"
GRP_P4D = "P4 | Status Dashboard"
GRP_P4A = "P4 | Alerts"

showSmtLn = input.bool(true, "Draw SMT trendlines", group=GRP_P4V, tooltip="Line between the previous and the current swing of the chart symbol that form the divergence. The previous swing is anchored on the open of its HTF bar (its exact candle is not stored), the current swing on the exact candle of the extreme.")
smtLnMode = input.string("Filtered only", "Draw lines for", options=["Filtered only", "All SMT events"], group=GRP_P4V, tooltip="Filtered only: SMT events that passed the midnight / killzone / liquidity filters. All SMT events: also draws the rejected ones (faded, no label).")
smtLnW    = input.int(2, "Line width", minval=1, maxval=5, group=GRP_P4V)
smtLnSty  = input.string("Dashed", "Line style", options=["Solid", "Dashed", "Dotted"], group=GRP_P4V)
colBullSmt = input.color(color.new(#00c853, 0), "Bullish SMT colour", group=GRP_P4V, inline="c1")
colBearSmt = input.color(color.new(#ff1744, 0), "Bearish SMT colour", group=GRP_P4V, inline="c1")
showMk    = input.bool(true, "Show entry markers on CISD confirmation", group=GRP_P4V)
mkSize    = input.string("Normal", "Marker size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GRP_P4V)
colBullMk = input.color(color.new(#00e676, 0), "Long marker colour", group=GRP_P4V, inline="c2")
colBearMk = input.color(color.new(#ff5252, 0), "Short marker colour", group=GRP_P4V, inline="c2")

showDash  = input.bool(true, "Show status dashboard", group=GRP_P4D)
dashPos   = input.string("Top Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=GRP_P4D)
dashSize  = input.string("Small", "Text size", options=["Tiny", "Small", "Normal", "Large"], group=GRP_P4D)
dashTheme = input.string("Dark", "Theme", options=["Dark", "Light"], group=GRP_P4D)
dashTrans = input.int(15, "Cell transparency %", minval=0, maxval=100, group=GRP_P4D)

smtAlertSrc = input.string("Filtered", "SMT alerts fire on", options=["Filtered", "Raw"], group=GRP_P4A, tooltip="Filtered: only SMT events that passed the Part 2 filters (midnight open, killzone, liquidity sweep).\nRaw: every Part 1 SMT event.")

// size / position / line-style string -> Pine constant
f_sz(string z) =>
    z == "Tiny" ? size.tiny : z == "Small" ? size.small : z == "Large" ? size.large : z == "Huge" ? size.huge : size.normal

f_lnStyle() =>
    smtLnSty == "Solid" ? line.style_solid : smtLnSty == "Dotted" ? line.style_dotted : line.style_dashed

f_dashPos() =>
    dashPos == "Top Left" ? position.top_left : dashPos == "Top Center" ? position.top_center : dashPos == "Middle Left" ? position.middle_left : dashPos == "Middle Right" ? position.middle_right : dashPos == "Bottom Left" ? position.bottom_left : dashPos == "Bottom Center" ? position.bottom_center : dashPos == "Bottom Right" ? position.bottom_right : position.top_right

// Draws the SMT divergence: trendline (previous swing -> current swing) + label. All coordinates are fixed
// at creation time (the swings are already confirmed), so nothing is ever redrawn or moved.
// Returns [line, label] so that an UNCONFIRMED early SMT can be removed again if it is invalidated.
f_drawSmt(bool bull, bool ok, int t0, float p0, int t1, float p1, string tf, string info) =>
    color c = bull ? colBullSmt : colBearSmt
    line  dl = na
    label dlb = na
    if showSmtLn and not na(t0) and not na(p0) and not na(t1) and not na(p1)
        dl := line.new(t0, p0, t1, p1, xloc=xloc.bar_time, color=ok ? c : color.new(c, 75), width=smtLnW, style=f_lnStyle())
    if showSig and ok and not na(t1) and not na(p1)
        dlb := label.new(t1, p1, (bull ? "Bullish SMT" : "Bearish SMT") + "\n" + tf, xloc=xloc.bar_time, style=bull ? label.style_label_up : label.style_label_down, color=color.new(c, 15), textcolor=color.white, size=size.small, tooltip=info)
    [dl, dlb]

// One pending setup per SMT timeframe and direction (slot = ti*2 + (bull ? 0 : 1)).
type Pend
    bool   active = false
    bool   bull   = true
    int    ti     = 0
    float  ext    = na   // SMT swing extreme (low for bull, high for bear): breaking it invalidates the setup
    int    t0     = na   // chart time the SMT was confirmed (pending state starts here)
    int    swT    = na   // chart time of the SMT swing extreme
    bool   early  = false // armed by the EARLY mode (provisional swing on the developing HTF candle)
    int    bk     = na   // open time of that developing HTF candle
    line   ln     = na   // SMT trendline / label of an UNCONFIRMED early SMT (deleted again if the setup is invalidated)
    label  lb     = na

// Removes the SMT drawing of an unconfirmed early setup (no-op when there is none / it was already confirmed).
f_dropDraw(Pend pd) =>
    if not na(pd.ln)
        line.delete(pd.ln)
    if not na(pd.lb)
        label.delete(pd.lb)
    pd.ln := na
    pd.lb := na
    true

// "240" -> "H4", "15" -> "M15", "D" -> "D" ...
f_tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string r = ""
    if sec >= 604800
        r := "W"
    else if sec >= 86400
        r := "D"
    else if sec >= 3600
        r := "H" + str.tostring(int(sec / 3600))
    else
        r := "M" + str.tostring(int(sec / 60))
    r

var array<Pend>   pends    = array.new<Pend>()
var array<string> stBull   = array.new_string(6, "·")
var array<string> stBear   = array.new_string(6, "·")
var array<int>    armDir   = array.new_int(6, 0)   // Part 4: direction (+1 bull / -1 bear) of the latest setup status change per SMT timeframe
var array<string> htfNames = array.from("W", "D", "H4", "H1", "M30", "M15")
var array<int>    ltfMsAll = array.from(timeframe.in_seconds(ltfW) * 1000, timeframe.in_seconds(ltfD) * 1000, timeframe.in_seconds(ltfH4) * 1000, timeframe.in_seconds(ltfH1) * 1000, timeframe.in_seconds(ltfM30) * 1000, timeframe.in_seconds(ltfM15) * 1000)
var array<string> ltfNames = array.from(f_tfName(ltfW), f_tfName(ltfD), f_tfName(ltfH4), f_tfName(ltfH1), f_tfName(ltfM30), f_tfName(ltfM15))

// Store of the most recent CISD events seen on the CHART timeframe (oldest first, max 300).
//   evDir  : +1 bullish CISD / -1 bearish CISD
//   evT    : open time of the candle that CLOSED through the level
//   evRef  : the level = open of the first candle of the delivery series that was broken
//   evRs/evRe : open time of the first / last candle of that delivery series
//   evPk   : highest high (bearish) / lowest low (bullish) from the series start up to the CISD candle
var array<int>   evDir = array.new<int>()
var array<int>   evT   = array.new<int>()
var array<float> evRef = array.new<float>()
var array<int>   evRs  = array.new<int>()
var array<int>   evRe  = array.new<int>()
var array<float> evPk  = array.new<float>()
var array<float> evH   = array.new<float>()   // high / low of the CISD candle (Part 4 marker position)
var array<float> evL   = array.new<float>()

if barstate.isfirst
    for k = 0 to 11
        pends.push(Pend.new())

// The CISD engine runs on the chart timeframe: it is only active when the chart IS one of the mapped LTFs.
int  chartMs = timeframe.in_seconds(timeframe.period) * 1000
bool ltfChart = false
for k = 0 to 5
    if ltfMsAll.get(k) == chartMs
        ltfChart := true

f_recEv(int dir, int t, float ref, int rs, int re, float pk, float hi, float lo) =>
    evDir.push(dir)
    evT.push(t)
    evRef.push(ref)
    evRs.push(rs)
    evRe.push(re)
    evPk.push(pk)
    evH.push(hi)
    evL.push(lo)
    if evDir.size() > 300
        evDir.shift()
        evT.shift()
        evRef.shift()
        evRs.shift()
        evRe.shift()
        evPk.shift()
        evH.shift()
        evL.shift()
    true

// ---------- Delivery-series tracker (closed candles only) ----------
// A delivery series = consecutive same-colour candles; its reference price is the OPEN of its FIRST candle.
//   Bearish CISD: a down-closing candle closes BELOW the open of the latest bullish series.
//   Bullish CISD: an up-closing candle closes ABOVE the open of the latest bearish series.
// Each series can be broken once; a doji continues the current series.
var float upOpen  = na
var int   upStart = na
var int   upEnd   = na
var float upPeak  = na
var bool  upArm   = false
var float dnOpen  = na
var int   dnStart = na
var int   dnEnd   = na
var float dnTrough = na
var bool  dnArm   = false
var int   runDir  = 0
bool newEv = false

if ltfChart and inScope and barstate.isconfirmed
    bool isUp = close > open
    bool isDn = close < open
    // 1) CISD against the series that PRECEDED this candle
    if isDn and upArm and not na(upOpen) and close < upOpen
        f_recEv(-1, time, upOpen, upStart, upEnd, math.max(upPeak, high), high, low)
        newEv := true
        upArm := false
    if isUp and dnArm and not na(dnOpen) and close > dnOpen
        f_recEv(1, time, dnOpen, dnStart, dnEnd, math.min(dnTrough, low), high, low)
        newEv := true
        dnArm := false
    // 2) update the delivery series
    if isUp
        if runDir != 1
            upOpen  := open
            upStart := time
            upPeak  := high
            upArm   := true
            runDir  := 1
        upEnd := time
    else if isDn
        if runDir != -1
            dnOpen   := open
            dnStart  := time
            dnTrough := low
            dnArm    := true
            runDir   := -1
        dnEnd := time
    // 3) keep the extremes of an unbroken series up to date (pullback candles included)
    if upArm
        upPeak := math.max(upPeak, high)
    if dnArm
        dnTrough := math.min(dnTrough, low)

// Index of the first stored CISD that belongs to THE LEG OF THIS SMT SWING, or -1:
//   - same direction as the SMT bias (swing high -> bearish CISD, swing low -> bullish CISD)
//   - the broken delivery series contains the swing extreme candle (or ends right before it)
//   - the CISD candle comes after the extreme
//   - price never traded beyond the SMT extreme between the series start and the CISD
f_matchEv(bool bull, float ext, int swT, int fromIdx) =>
    int r = -1
    int n = evDir.size()
    float tk = syminfo.mintick
    if n > 0 and fromIdx >= 0 and fromIdx < n
        for i = fromIdx to n - 1
            bool okDir = evDir.get(i) == (bull ? 1 : -1)
            bool okLeg = evRs.get(i) <= swT and evRe.get(i) + chartMs >= swT and evT.get(i) > swT
            bool okBrk = bull ? evPk.get(i) >= ext - tk : evPk.get(i) <= ext + tk
            if okDir and okLeg and okBrk
                r := i
                break
    r

// Called by the filter pipeline when a fully filtered SMT is confirmed: puts the setup into the PENDING state.
// The CISD can only be monitored when the chart timeframe is the mapped LTF.
f_arm(int ti, bool bull, float p, int swT, bool early, int bk) =>
    Pend pd = pends.get(ti * 2 + (bull ? 0 : 1))
    f_dropDraw(pd)   // a still-pending older early setup in this slot is replaced -> its drawing goes too
    bool mine = ltfMsAll.get(ti) == chartMs
    pd.active := mine
    pd.bull := bull
    pd.ti := ti
    pd.ext := p
    pd.t0 := time
    pd.swT := swT
    pd.early := early
    pd.bk := bk
    armDir.set(ti, bull ? 1 : -1)
    string s = mine ? "PEND" : "open " + ltfNames.get(ti)
    if bull
        stBull.set(ti, s)
    else
        stBear.set(ti, s)
    true

// ============================== 15. FILTER PIPELINE ==================================
// Returns [ok, info, sweptLevel, swingTime, swingPrice]
f_filt(bool bull, bool ev, Swing ch, int tfMs, int ti) =>
    bool   ok   = false
    string info = "-"
    string sw   = ""
    string sk   = ""
    int    lt   = na
    float  p    = na
    if ev
        p := bull ? ch.lP : ch.hP
        int bt = bull ? ch.lT : ch.hT
        int et = f_extRec(ti, bull, bt, tfMs)
        lt := na(et) ? bt : et
        int tt = na(et) ? bt + tfMs - 1 : et

        bool midOk = true
        if useMid
            float o = na(et) ? nyOpen : f_openFor(et)
            midOk := not na(o) and (bull ? p < o : p > o)

        string kz = ""
        bool kzOk = true
        if useKZ
            kz := na(et) ? f_kzSpan(bt, tfMs) : f_kzName(et)
            kzOk := kz != ""

        bool swOk = true
        if useSweep
            [swValid, swSkip] = f_sweep(not bull, p, bt, tt)
            sw := swValid
            sk := swSkip
            swOk := sw != ""

        ok := midOk and kzOk and swOk
        info := ok ? "✔ " + kz + " | " + sw : "✖ " + (midOk ? "" : "MID ") + (kzOk ? "" : "KZ ") + (swOk ? "" : "SWEEP")
    [ok, info, sw, lt, p, sk]

var array<bool>   okBull   = array.new_bool(6, false)
var array<bool>   okBear   = array.new_bool(6, false)
var array<string> infoBull = array.new_string(6, "-")
var array<string> infoBear = array.new_string(6, "-")
// Part 4 dashboard: liquidity-alignment status of the LAST evaluated SMT event per timeframe
var array<string> liqTxt = array.new_string(6, "—")
var array<string> liqTip = array.new_string(6, "")

var float lastBullSigPrice = na
var int   lastBullSigBar   = na
var float lastBearSigPrice = na
var int   lastBearSigBar   = na

int bullSigCount = 0
int bearSigCount = 0
int rawBullCount = 0   // Part 4: raw (unfiltered) Part 1 SMT events on this bar, used by the "Raw" alert source
int rawBearCount = 0
if inScope
    for i = 0 to 5
        SMTResult sr = smtAll.get(i)
        Swing     sc = chAll.get(i)
        int       sm = tfMsAll.get(i)

        if sr.bullNew
            rawBullCount += 1
        if sr.bearNew
            rawBearCount += 1

        bool isE = earlyMode and i == eTi   // this timeframe runs in EARLY mode on the current chart
        bool evBull = sr.bullNew and inScope
        bool evBear = sr.bearNew and inScope

        [bOk, bInfo, bSw, bT, bP, bSk] = f_filt(true,  evBull, sc, sm, i)
        [sOk, sInfo, sSw, sT, sP, sSk] = f_filt(false, evBear, sc, sm, i)

        okBull.set(i, bOk)
        okBear.set(i, sOk)
        if evBull
            infoBull.set(i, bInfo)
            // dashboard liquidity status: Valid Level / Skipped Session (swept level not aligned) / No Sweep
            liqTxt.set(i, not useSweep ? "▲ Filter off" : bSw != "" ? "▲ Valid Level" : bSk != "" ? (str.startswith(bSk, "P") ? "▲ Skipped Level" : "▲ Skipped Session") : "▲ No Sweep")
            liqTip.set(i, bSw != "" ? bSw : bSk)
        if evBear
            infoBear.set(i, sInfo)
            liqTxt.set(i, not useSweep ? "▼ Filter off" : sSw != "" ? "▼ Valid Level" : sSk != "" ? (str.startswith(sSk, "P") ? "▼ Skipped Level" : "▼ Skipped Session") : "▼ No Sweep")
            liqTip.set(i, sSw != "" ? sSw : sSk)

        if bOk
            bullSigCount += 1
            lastBullSigPrice := bP
            lastBullSigBar   := bar_index
            f_arm(i, true, bP, bT, isE, sc.lT)
        if sOk
            bearSigCount += 1
            lastBearSigPrice := sP
            lastBearSigBar   := bar_index
            f_arm(i, false, sP, sT, isE, sc.hT)

        // Part 4 overlay: trendline previous swing -> current swing (+ label for filtered events)
        if evBull and (bOk or smtLnMode == "All SMT events")
            [dlB, dlbB] = f_drawSmt(true,  bOk, sc.lTPrev, sc.lPrev, bT, bP, sr.tf + (isE ? " early" : "") + (bSw != "" ? " | " + bSw : ""), bInfo)
            if isE and bOk
                Pend pbE = pends.get(i * 2)
                pbE.ln := dlB
                pbE.lb := dlbB
        if evBear and (sOk or smtLnMode == "All SMT events")
            [dlS, dlbS] = f_drawSmt(false, sOk, sc.hTPrev, sc.hPrev, sT, sP, sr.tf + (isE ? " early" : "") + (sSw != "" ? " | " + sSw : ""), sInfo)
            if isE and sOk
                Pend psE = pends.get(i * 2 + 1)
                psE.ln := dlS
                psE.lb := dlbS

bool bullSig = bullSigCount > 0
bool bearSig = bearSigCount > 0

// (alert conditions live in the PART 4 block at the end of the script)

// ============================== 16. VISUALS ==========================================
string curKz = f_kzM(nyMin)
color  kzCol = curKz == "Asia" ? color.new(color.purple, 92) : curKz == "London" ? color.new(color.blue, 92) : curKz == "NY AM" ? color.new(color.teal, 92) : curKz == "NY PM" ? color.new(color.orange, 92) : na
bgcolor(showKZbg ? kzCol : na)

var array<line>  lvLines  = array.new<line>()
var array<label> lvLabels = array.new<label>()

// Level lines / labels are rebuilt once per new bar (not on every realtime tick).
if barstate.islast and barstate.isnew
    for ln in lvLines
        line.delete(ln)
    lvLines.clear()
    for lb in lvLabels
        label.delete(lb)
    lvLabels.clear()
    if showLvl and pool.size() > 0
        for i = 0 to pool.size() - 1
            Liq L = pool.get(i)
            bool aligned = L.alIdx < 99
            bool swept = not na(L.sweptT)
            if (aligned or showInv) and (not swept or showSwpt)
                string a = f_aligned(L)
                color c = aligned ? (L.isHigh ? color.red : color.green) : color.gray
                int x2 = swept ? math.max(L.sweptT, L.t + 1) : time
                lvLines.push(line.new(L.t, L.price, x2, L.price, xloc=xloc.bar_time, color=c, style=swept ? line.style_dotted : line.style_solid))
                lvLabels.push(label.new(x2, L.price, L.name + (aligned ? " ✓" + a : " ✗"), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(c, 85), textcolor=c, size=size.tiny))

// ============================== 17. PART 2 DEBUG TABLE ===============================
int validLvls = 0
if barstate.islast and pool.size() > 0
    for i = 0 to pool.size() - 1
        Liq lv2 = pool.get(i)
        if lv2.alIdx < 99 and na(lv2.sweptT)
            validLvls += 1

var table dbg2 = table.new(position.bottom_right, 3, 8, border_width=1)
if showDbg2 and barstate.islast
    hdr2 = array.from("TF", "Bull SMT (last eval)", "Bear SMT (last eval)")
    for c = 0 to 2
        table.cell(dbg2, c, 0, hdr2.get(c), text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    for i = 0 to 5
        SMTResult r2 = smtAll.get(i)
        table.cell(dbg2, 0, i + 1, r2.tf, text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
        table.cell(dbg2, 1, i + 1, infoBull.get(i), text_color=color.white, bgcolor=okBull.get(i) ? color.new(color.green, 20) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dbg2, 2, i + 1, infoBear.get(i), text_color=color.white, bgcolor=okBear.get(i) ? color.new(color.red, 20) : color.new(color.gray, 80), text_size=size.small)
    table.cell(dbg2, 0, 7, "NY Open", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(dbg2, 1, 7, str.tostring(nyOpen, format.mintick), text_color=color.white, bgcolor=color.new(color.orange, 40), text_size=size.small)
    table.cell(dbg2, 2, 7, "Valid levels: " + str.tostring(validLvls) + " / " + str.tostring(pool.size()), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

// =====================================================================================
//  PART 3 : LTF CISD (CHANGE IN STATE OF DELIVERY) CONFIRMATION ENGINE
//
//  Flow:  filtered HTF SMT (Part 2)  ->  PENDING state (f_arm)  ->  CISD on the mapped LTF
//         Weekly->H4 | Daily->H1 | H4->M15 | H1->M5 | M30->M3 | M15->M1   (editable in the inputs)
//         Open the mapped LTF chart to see the CISD (e.g. H1 SMT -> M5 chart).
//
//  CISD for an SMT = a candle close beyond the OPEN of the delivery series (run of same-colour candles)
//  that delivered the leg INTO the SMT swing extreme:
//     bearish SMT (swing high): first close BELOW the open of the bullish series containing the swing high
//     bullish SMT (swing low) : first close ABOVE the open of the bearish series containing the swing low
//  The HTF SMT is only confirmed some bars after the swing, so the CISD is looked up retroactively and drawn
//  on the exact LTF candle where it happened (line = series open price, label "CISD-m5").
//
//  Invalidation of a pending setup:
//    - price trades beyond the HTF SMT extreme (low < bull SMT low / high > bear SMT high), OR
//    - more than "Max Confirmation Bars" bars of the mapped LTF have elapsed since the SMT was confirmed.
//
//  Exports: cisdOkBull[i] / cisdOkBear[i] (confirmed on this bar, i = 0..5), cisdBullNow / cisdBearNow,
//           lastCisdBullBar / lastCisdBearBar, stBull[i] / stBear[i] (status text per SMT timeframe).
// =====================================================================================

var array<bool> cisdOkBull = array.new_bool(6, false)
var array<bool> cisdOkBear = array.new_bool(6, false)
var int lastCisdBullBar = na
var int lastCisdBearBar = na

bool cisdBullNow = false
bool cisdBearNow = false
for i = 0 to 5
    cisdOkBull.set(i, false)
    cisdOkBear.set(i, false)

// ---------- Monitor every pending setup (12 slots, trivial per-bar cost) ----------
for k = 0 to 11
    Pend pd = pends.get(k)
    if pd.active
        int lms = ltfMsAll.get(pd.ti)
        int idx = -1
        // EARLY setups: while the HTF candle that carries the swing is still developing, the swing extreme follows the
        // live extreme (as long as the divergence holds); the setup is void as soon as the divergence disappears.
        bool eLive = pd.early and time < pd.bk + tfMsAll.get(pd.ti)
        bool eVoid = false
        if eLive and barstate.isconfirmed and pd.t0 != time
            SMTResult eq = smtAll.get(pd.ti)
            bool eOn = pd.bull ? eq.bull : eq.bear
            if eOn
                Swing es = chAll.get(pd.ti)
                float np = pd.bull ? es.lP : es.hP
                int   nb = pd.bull ? es.lT : es.hT
                if nb == pd.bk and (pd.bull ? np < pd.ext : np > pd.ext)
                    int ne = f_extRec(pd.ti, pd.bull, nb, tfMsAll.get(pd.ti))
                    pd.ext := np
                    if not na(ne)
                        pd.swT := ne
            else
                eVoid := true
        if pd.t0 == time
            idx := f_matchEv(pd.bull, pd.ext, pd.swT, 0)                  // just armed: the CISD may already have happened
        else if newEv
            idx := f_matchEv(pd.bull, pd.ext, pd.swT, evDir.size() - 1)   // only the newest event can be new
        bool inTime = false
        if idx >= 0
            inTime := evT.get(idx) <= pd.t0 + maxConf * lms
        bool broke   = eLive ? eVoid : (pd.bull ? low < pd.ext : high > pd.ext)
        bool expired = (time - pd.t0) / lms > maxConf
        if inTime
            pd.active := false
            pd.ln := na   // confirmed by the CISD -> the SMT drawing stays on the chart
            pd.lb := na
            armDir.set(pd.ti, pd.bull ? 1 : -1)
            if pd.bull
                cisdBullNow := true
                cisdOkBull.set(pd.ti, true)
                lastCisdBullBar := bar_index
                stBull.set(pd.ti, "✔ CISD")
            else
                cisdBearNow := true
                cisdOkBear.set(pd.ti, true)
                lastCisdBearBar := bar_index
                stBear.set(pd.ti, "✔ CISD")
            int t1 = evT.get(idx)   // open time of the candle that CLOSED through the delivery-series open = the CISD candle
            if showCisd
                color col = pd.bull ? color.green : color.red
                float lvl = evRef.get(idx)
                line.new(evRs.get(idx), lvl, t1, lvl, xloc=xloc.bar_time, color=col, width=2)
                label.new(t1, lvl, "CISD-" + str.lower(ltfNames.get(pd.ti)), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.normal, tooltip=htfNames.get(pd.ti) + " SMT -> " + ltfNames.get(pd.ti) + " CISD")
            // Part 4 entry marker: arrow below the low (long) / above the high (short) of the exact CISD candle
            if showMk
                label.new(t1, pd.bull ? evL.get(idx) : evH.get(idx), "", xloc=xloc.bar_time, style=pd.bull ? label.style_arrowup : label.style_arrowdown, color=pd.bull ? colBullMk : colBearMk, size=f_sz(mkSize), tooltip=(pd.bull ? "LONG" : "SHORT") + " | " + htfNames.get(pd.ti) + " SMT -> " + ltfNames.get(pd.ti) + " CISD confirmed")
        else if broke
            pd.active := false
            f_dropDraw(pd)   // unconfirmed early SMT invalidated -> remove it from the chart
            armDir.set(pd.ti, pd.bull ? 1 : -1)
            if pd.bull
                stBull.set(pd.ti, "✖ BROKE")
            else
                stBear.set(pd.ti, "✖ BROKE")
        else if expired
            pd.active := false
            f_dropDraw(pd)   // no CISD in time -> remove the unconfirmed early SMT
            armDir.set(pd.ti, pd.bull ? 1 : -1)
            if pd.bull
                stBull.set(pd.ti, "✖ EXPIRED")
            else
                stBear.set(pd.ti, "✖ EXPIRED")

// (alert conditions live in the PART 4 block at the end of the script)

// ---------- Part 3 status table: live SMT / filter (alignment+sweep) / CISD for all 6 pairs ----------
f_stBg(string s) =>
    s == "PEND" ? color.new(color.orange, 30) : str.startswith(s, "✔") ? color.new(color.green, 25) : str.startswith(s, "✖") ? color.new(color.red, 60) : color.new(color.gray, 85)

var table tbl3 = table.new(position.bottom_left, 6, 7, border_width=1)
if showTbl3 and barstate.islast
    hdr3 = array.from("SMT→CISD", "SMT now", "Bull filter", "Bear filter", "CISD ▲", "CISD ▼")
    for c = 0 to 5
        table.cell(tbl3, c, 0, hdr3.get(c), text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    for i = 0 to 5
        SMTResult q = smtAll.get(i)
        string smtTxt = q.bull ? "▲" : q.bear ? "▼" : "·"
        table.cell(tbl3, 0, i + 1, htfNames.get(i) + "→" + ltfNames.get(i), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
        table.cell(tbl3, 1, i + 1, smtTxt, text_color=color.white, bgcolor=q.bull ? color.new(color.green, 40) : q.bear ? color.new(color.red, 40) : color.new(color.gray, 85), text_size=size.small)
        table.cell(tbl3, 2, i + 1, infoBull.get(i), text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
        table.cell(tbl3, 3, i + 1, infoBear.get(i), text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
        table.cell(tbl3, 4, i + 1, stBull.get(i), text_color=color.white, bgcolor=f_stBg(stBull.get(i)), text_size=size.small)
        table.cell(tbl3, 5, i + 1, stBear.get(i), text_color=color.white, bgcolor=f_stBg(stBear.get(i)), text_size=size.small)


// =====================================================================================
//  PART 4 : STATUS DASHBOARD + ALERT SYSTEM  (overlay lines / markers are drawn above, where the events are born)
//
//  Overlay recap (code lives in the pipeline loop and in the CISD monitor):
//    - f_drawSmt()           : trendline previous swing -> current swing + "Bullish SMT" / "Bearish SMT" label
//    - CISD monitor marker   : green arrow (long) / red arrow (short) on the exact candle that closed through the CISD level
//
//  Dashboard (one row per SMT -> LTF pair):
//    HTF SMT        : Active (▲ bullish / ▼ bearish divergence currently valid) | Inactive | Off (timeframe disabled)
//    MTF Liquidity  : result of the sweep / alignment check of the LAST evaluated SMT event
//                     Valid Level | Skipped Session (swept a session level that is not aligned with a W/D/H4/H1/M30 swing)
//                     | Skipped Level (same for PDH/PDL/PWH/PWL) | No Sweep | Filter off
//    LTF CISD       : status of the LATEST setup: Pending | Confirmed | Failed (price broke the SMT extreme or it expired)
// =====================================================================================

// Timeframe-enabled flags in the same order as smtAll (0=W 1=D 2=H4 3=H1 4=M30 5=M15)
var array<bool> tfOnAll = array.from(onW, onD, onH4, onH1, onM30, onM15)

// Colour palette (theme)
color dBg   = dashTheme == "Dark" ? #131722 : #ffffff
color dHdr  = dashTheme == "Dark" ? #2a2e39 : #d1d4dc
color dTxt  = dashTheme == "Dark" ? color.white : #131722
color dMute = dashTheme == "Dark" ? #787b86 : #6b6e7b

// CISD column text for SMT timeframe ti: direction arrow + Pending / Confirmed / Failed
f_cisdTxt(int ti) =>
    int d = armDir.get(ti)
    string r = "—"
    if d != 0
        string st = d > 0 ? stBull.get(ti) : stBear.get(ti)
        string a  = d > 0 ? "▲ " : "▼ "
        if st == "PEND"
            r := a + "Pending"
        else if str.startswith(st, "✔")
            r := a + "Confirmed"
        else if str.startswith(st, "✖")
            r := a + "Failed"
        else if str.startswith(st, "open")
            r := a + "Pending (" + ltfNames.get(ti) + ")"   // armed, but the chart is not on the mapped LTF so it cannot be monitored
    r

f_cisdBg(string t) =>
    str.contains(t, "Confirmed") ? (str.startswith(t, "▲") ? color.new(color.green, dashTrans) : color.new(color.red, dashTrans)) : str.contains(t, "Pending") ? color.new(color.orange, dashTrans) : str.contains(t, "Failed") ? color.new(color.maroon, dashTrans) : color.new(dMute, 80)

f_liqBg(string t) =>
    str.contains(t, "Valid") ? color.new(color.green, dashTrans) : str.contains(t, "Skipped") ? color.new(color.orange, dashTrans) : color.new(dMute, 80)

var table dash = table.new(f_dashPos(), 4, 8, border_width=1, border_color=dashTheme == "Dark" ? #363a45 : #b2b5be)

if showDash and barstate.islast
    string dsz = f_sz(dashSize)
    // header
    hdr4 = array.from("SMT → LTF", "HTF SMT", "MTF Liquidity", "LTF CISD")
    for c = 0 to 3
        table.cell(dash, c, 0, hdr4.get(c), text_color=dTxt, bgcolor=dHdr, text_size=dsz)
    // one row per timeframe pair
    for i = 0 to 5
        SMTResult q = smtAll.get(i)
        bool on = tfOnAll.get(i)

        string smtTxt = not on ? "Off" : q.bull and q.bear ? "Active ▲▼" : q.bull ? "Active ▲" : q.bear ? "Active ▼" : "Inactive"
        color  smtBg  = not on ? color.new(dMute, 85) : q.bull and q.bear ? color.new(color.orange, dashTrans) : q.bull ? color.new(color.green, dashTrans) : q.bear ? color.new(color.red, dashTrans) : color.new(dMute, 80)
        string liqT   = on ? liqTxt.get(i) : "Off"
        string cisdT  = on ? f_cisdTxt(i) : "Off"

        table.cell(dash, 0, i + 1, htfNames.get(i) + " → " + ltfNames.get(i), text_color=dTxt, bgcolor=color.new(dHdr, dashTrans), text_size=dsz)
        table.cell(dash, 1, i + 1, smtTxt, text_color=dTxt, bgcolor=smtBg, text_size=dsz, tooltip=q.bull ? "Bullish SMT: chart lower low not confirmed by the comparison symbol" : q.bear ? "Bearish SMT: chart higher high not confirmed by the comparison symbol" : "No SMT divergence on the latest aligned swing pair")
        table.cell(dash, 2, i + 1, liqT, text_color=dTxt, bgcolor=on ? f_liqBg(liqT) : color.new(dMute, 85), text_size=dsz, tooltip=liqTip.get(i) == "" ? "No SMT event evaluated yet" : "Swept level: " + liqTip.get(i))
        table.cell(dash, 3, i + 1, cisdT, text_color=dTxt, bgcolor=on ? f_cisdBg(cisdT) : color.new(dMute, 85), text_size=dsz, tooltip=armDir.get(i) > 0 ? "Last status: " + stBull.get(i) : armDir.get(i) < 0 ? "Last status: " + stBear.get(i) : "No setup yet")
    // footer: tells the user whether the CISD engine can run on the current chart timeframe
    table.cell(dash, 0, 7, "Chart TF", text_color=dMute, bgcolor=color.new(dBg, dashTrans), text_size=dsz)
    table.cell(dash, 1, 7, timeframe.period, text_color=dTxt, bgcolor=color.new(dBg, dashTrans), text_size=dsz)
    table.cell(dash, 2, 7, "CISD engine", text_color=dMute, bgcolor=color.new(dBg, dashTrans), text_size=dsz)
    table.cell(dash, 3, 7, ltfChart ? "ON" : "OFF – use a mapped LTF", text_color=ltfChart ? color.green : color.orange, bgcolor=color.new(dBg, dashTrans), text_size=dsz, tooltip="CISD is only monitored when the chart timeframe equals the LTF mapped to a pair (inputs 'P3 | CISD Confirmation').")

// ============================== ALERT SYSTEM (exactly 4 conditions) ===================
// 1 / 2 : HTF SMT formed. Source = filtered (Part 2) or raw (Part 1) depending on the input.
// 3 / 4 : LTF CISD confirmed for a pending, filtered HTF SMT (Part 3).
// All conditions are true only on the bar where the event is confirmed -> use "Once Per Bar Close".
bool alBullSmt = smtAlertSrc == "Filtered" ? bullSig : rawBullCount > 0
bool alBearSmt = smtAlertSrc == "Filtered" ? bearSig : rawBearCount > 0

alertcondition(alBullSmt,   title="1. HTF Bullish SMT Formed",                  message="HTF Bullish SMT formed on {{ticker}} ({{interval}})")
alertcondition(alBearSmt,   title="2. HTF Bearish SMT Formed",                  message="HTF Bearish SMT formed on {{ticker}} ({{interval}})")
alertcondition(cisdBullNow, title="3. Bullish CISD Confirmed (LTF Trigger)",    message="Bullish CISD confirmed (LTF trigger) on {{ticker}} ({{interval}}) - long setup")
alertcondition(cisdBearNow, title="4. Bearish CISD Confirmed (LTF Trigger)",    message="Bearish CISD confirmed (LTF trigger) on {{ticker}} ({{interval}}) - short setup")
